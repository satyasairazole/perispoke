# ── StepOne Bot Config ──────────────────────────────────────
# Copy this file, rename to .env, fill in your real values

# 1. Your Anthropic API key
#    Get it from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 2. Your Periskope API key
#    Get it from: console.periskope.app → Settings → API
PERISKOPE_API_KEY=eyJYOUR_PERISKOPE_KEY_HERE

# 3. Your bot WhatsApp number (with country code + @c.us)
#    Example for India +91 86570 22012 → 918657022012@c.us
PERISKOPE_PHONE_ID=918657022012@c.us

# 4. Port (leave as 3000 unless something else is using it)
PORT=3000
